# Kleeblatt Adventure — Web client environment (Vite)
# Copy to apps/web/.env for local development (npm run dev).
#
# These vars are also injected in CI from GitHub secrets of the SAME name
# (see .github/workflows/deploy.yml). If unset, the web client falls back to
# the committed testnet addresses in src/game/config/contracts.ts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Immutable zkEVM Testnet (chainId 13473) — deployed contract addresses
# (source of truth: contracts/deployments/testnet.json)
VITE_FAUCET_CONTRACT_ADDRESS=0x294C16418798e9F110CB64649eB7dBaA8c44abb1
VITE_STAKING_CONTRACT_ADDRESS=0x3a4e037F4Bf020a430A75822d01d23f0fe19b75F
VITE_KLT_CONTRACT_ADDRESS=0x2fafEd30191509571Ed4Ca302a599A9d7ccCEFD4

# Optional: treasury that receives Shop purchases (defaults to deployer if unset)
VITE_SHOP_TREASURY_ADDRESS=0xb117F9aA2bC3C4CE63E8A4BB78f1fA7f80731Bd3
