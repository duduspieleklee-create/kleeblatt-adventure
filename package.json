{
  "name": "kleeblatt-adventure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kleeblatt Adventure – 2D browser adventure with optional Immutable zkEVM ownership (prototype monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@kleeblatt/web --filter=@kleeblatt/api",
    "dev:api": "turbo run dev --filter=@kleeblatt/api",
    "dev:web": "turbo run dev --filter=@kleeblatt/web",
    "dev:all": "turbo run dev --parallel --filter=@kleeblatt/web --filter=@kleeblatt/api",
    "build": "node scripts/validate-asset-manifest.mjs && turbo run build",
    "build:shared": "turbo run build --filter=@kleeblatt/shared",
    "build:api": "turbo run build --filter=@kleeblatt/api",
    "build:web": "turbo run build --filter=@kleeblatt/web",
    "validate:assets": "node scripts/validate-asset-manifest.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:root": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:seed": "node scripts/seed.mjs",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "prepare": "echo ready"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.9"
  }
}
