# Kleeblattadventure – Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Core ──────────────────────────────────────────────────────
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://kleeblatt:kleeblatt@localhost:5432/kleeblatt
REDIS_URL=redis://localhost:6379

# ─── Auth (Google OAuth 2.0) ─────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Session secret – generate with: openssl rand -hex 32
SESSION_SECRET=

# Local only: enable GET /auth/dev-login without Google
AUTH_DEV_BYPASS=false

# ─── Wallet (Prototyp: Mock) ────────────────────────────────────
# In production: "turnkey" or "dfns". For prototype: "mock"
WALLET_PROVIDER=mock

# ─── Game Config ──────────────────────────────────────────────
# Path to game-config.json (relative to apps/api)
GAME_CONFIG_PATH=../../game-config.json

# ─── Ports ───────────────────────────────────────────────────
PORT_API=4000
PORT_WEB=5173
