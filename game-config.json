{
  "version": "1.0.0",
  "description": "Kleeblattadventure – Game-Konfiguration für Prototyp P0–P7",
  "auth": {
    "provider": "google",
    "providerNote": "Google OAuth 2.0 als einziger Login für den Prototyp. E-Mail-Magic-Link und Wallet-Connect kommen später (M1+).",
    "session": {
      "type": "jwt",
      "cookieName": "kleeblatt_session",
      "ttlMinutes": 10080,
      "refreshThresholdMinutes": 1440,
      "sameSite": "lax",
      "secure": false,
      "httpOnly": true
    },
    "env": {
      "GOOGLE_CLIENT_ID": "required – aus Google Cloud Console",
      "GOOGLE_CLIENT_SECRET": "required – aus Google Cloud Console",
      "GOOGLE_CALLBACK_URL": "http://localhost:4000/auth/google/callback",
      "SESSION_SECRET": "required – zufälliger String ≥ 32 Zeichen",
      "API_URL": "http://localhost:4000",
      "WEB_URL": "http://localhost:5173",
      "CORS_ORIGIN": "http://localhost:5173"
    },
    "routes": {
      "login": "GET /auth/google – leitet zu Google OAuth weiter",
      "callback": "GET /auth/google/callback – OAuth-Code-Austausch, JWT-Cookie setzen, Redirect zu WEB_URL",
      "me": "GET /me – gibt userId, hero (falls vorhanden) zurück",
      "logout": "POST /auth/logout – Session löschen"
    }
  },
  "statStacking": {
    "formula": "final = base + gear + levelBonus",
    "levelBonusHp": "hero.baseStats.maxHp + (level - 1) * hero.levelBonuses.hpPerLevel",
    "levelBonusAtk": "hero.baseStats.atk + (level - 1) * hero.levelBonuses.atkPerLevel",
    "gearBonus": "summe aller ausgerüsteten items.stats",
    "rules": "Alle Stats sind additiv. Keine Multiplikatoren im Prototyp."
  },
