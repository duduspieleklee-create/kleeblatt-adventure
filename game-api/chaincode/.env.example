# ═══════════════════════════════════════════════════════
# GalaChain Secrets — Required for on-chain features
# ═══════════════════════════════════════════════════════
# Copy this to .env and fill in values from GitHub Secrets:
#   Settings → Secrets and variables → Actions → Repository secrets
#
# All secrets are injected by GitHub Actions during deploy.
# Locally: copy .env.example to .env and fill in manually.
# ═══════════════════════════════════════════════════════

# GitHub Secret: GALA_PRIVATE_KEY
# The private key of the publisher wallet that signs chaincode transactions.
# Generate via GalaChain SDK: WalletUtils.createRandom() → .privateKey
# Required for: minting Kleeblatt Coins, submitting scores on-chain
GALA_PRIVATE_KEY=0x_your_publisher_wallet_private_key_here

# GitHub Secret: GALA_CHAINCODE_URL
# The REST API URL of your deployed chaincode on the GalaChain gateway.
# Format: https://gateway-testnet.galachain.com/api/<channel>/<chaincode-name>-<ContractName>
# Get this from: galachain info after deployment
# Required for: calling TokenApi.MintToken, GetLeaderboard queries
GALA_CHAINCODE_URL=https://gateway-testnet.galachain.com/api/product-channel/kleeblattcoin-KleeblattCoinContract

# GitHub Secret: GALA_REST_API  
# The base REST API URL for the GalaChain gateway.
# Testnet: https://gateway-testnet.galachain.com/api
# Mainnet: https://gateway.galachain.com/api
GALA_REST_API=https://gateway-testnet.galachain.com/api

# Optional: mint service port
PORT=8002
