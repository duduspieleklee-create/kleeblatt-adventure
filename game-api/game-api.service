[Unit]
Description=Kleeblatt Game API
After=network.target postgresql@15-main.service
Requires=postgresql@15-main.service

[Service]
Type=simple
User=debian
WorkingDirectory=/opt/game-api
EnvironmentFile=/opt/game-api/.env
ExecStart=/usr/local/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
