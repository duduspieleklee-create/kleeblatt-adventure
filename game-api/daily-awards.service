[Unit]
Description=Kleeblatt Game Daily Awards
After=network.target postgresql@15-main.service game-api.service

[Service]
Type=oneshot
User=debian
WorkingDirectory=/opt/game-api
EnvironmentFile=/opt/game-api/.env
ExecStart=/usr/bin/python3 /opt/game-api/daily_awards.py

[Install]
WantedBy=multi-user.target
